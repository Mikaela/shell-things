	fi

	# Symlink cleanup
	if hash symlinks 2> /dev/null; then
		symlinks -d /etc/xdg/autostart/
		symlinks -d /etc/udev/rules.d/
		symlinks -d /usr/local/bin/
		symlinks -d /usr/local/share/fonts/
	else
		echo "WARNING! Executable named symlinks not found in PATH."
		sleep 3
	fi
