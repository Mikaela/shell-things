# Don't use this file alone, append it to something else.
# This may be necessary regardless of forward-first since apparently that
# option doesn't help with port 853 being blocked by restrictive firewall.
server:
	tls-system-cert: yes
	qname-minimisation: no
forward-zone:
	name: "."
	forward-tls-upstream: yes
	# https://appliedprivacy.net/services/dns/ - Vienna, Austria, no ECS
	forward-addr: 2a02:1b8:10:234::2@443#dot1.applied-privacy.net
	forward-addr: 146.255.56.98@443#dot1.applied-privacy.net

	# In case of SERVFAIL, fallback to less specific queries
	forward-first: yes

# vim: filetype=unbound.conf
