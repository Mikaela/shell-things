[Unit]
Description=Aminda's deduplication service
# Well really wants nothing, but I want ssh even if this gets stuck somewhere
Wants=ssh.socket sshd.socket

[Service]
Type=notify
ExecStart=/usr/local/bin/aminda-duperemove-service.bash
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
